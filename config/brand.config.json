{
  "name": "Kanishk.Rewires",
  "wordmark": {
    "left": "kanishk",
    "dot": ".",
    "right": "rewires",
    "case": "lower",
    "note": "User, 2026-10-17: the wordmark is always lowercase (kanishk.rewires), never uppercase."
  },
  "handle": "@kanishk.rewires",
  "tagline": "Rethink how you think.",
  "philosophy": "Information is the new social currency.",
  "palette": {
    "charcoal": "#0A0A0A",
    "graphite": "#1F1F1F",
    "cream": "#F6F4ED",
    "stone": "#D9D6CC",
    "grey": "#9A9A93",
    "lime": "#A7FF3F",
    "paleLime": "#E8FFB8"
  },
  "fonts": {
    "headline": {
      "family": "Space Grotesk",
      "source": "Google Fonts (OFL)",
      "weights": [
        400,
        500,
        700
      ]
    },
    "body": {
      "family": "Inter",
      "source": "Google Fonts (OFL)",
      "weights": [
        400,
        500,
        600,
        700
      ]
    },
    "mono": {
      "family": "IBM Plex Mono",
      "source": "Google Fonts (OFL)",
      "weights": [
        400,
        500,
        600
      ]
    },
    "wordmarkSerif": {
      "family": "Instrument Serif",
      "source": "Google Fonts (OFL)",
      "weights": [
        400
      ],
      "note": "Stand-in for the light high-contrast serif used for REWIRES on the brand board, until the original wordmark artwork exists as a file."
    }
  },
  "logo": {
    "monogram": "brand/logo/kr-monogram.png",
    "monogramPublic": "brand/rewires/kr-monogram.png",
    "monogramOnBlack": "brand/logo/kr-monogram-on-black.png",
    "monogramOnWhite": "brand/logo/kr-monogram-on-white.png",
    "brandBoard": "brand/references/brand-board.png",
    "logoSheet": "brand/references/logo-sheet.png"
  },
  "captions": {
    "maxWordsPerPage": 4,
    "maxHighlightsPerScene": 1,
    "safeTopPct": 0.12,
    "safeBottomPct": 0.18,
    "sideMarginPx": 80
  },
  "outro": {
    "seconds": 3.0,
    "holdSeconds": 1.0
  },
  "rules": {
    "noDashesOnScreen": true,
    "exactBrandSpellings": [
      "kanishk.rewires",
      "Kanishk.Rewires",
      "@kanishk.rewires",
      "KANISHK.REWIRES"
