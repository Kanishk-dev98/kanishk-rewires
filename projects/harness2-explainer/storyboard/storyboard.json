      "sfx": [{ "name": "tick", "on": { "cue": "carry" }, "volume": 0.25 }] },
    { "id": "s10", "type": "xBeat", "pad": 6, "energy": 2,
      "vo": "Your agent gets better at getting better.", "accents": ["better."],
      "data": { "kind": "chart", "title": "SCORE ACROSS TASKS · ILLUSTRATIVE", "points": [40, 47, 53, 59, 64, 70, 76, 82], "baseline": [40, 41, 42, 43, 44, 45, 45, 46], "label": "better" },
