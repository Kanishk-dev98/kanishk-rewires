    { "id": "s09", "type": "xBeat", "pad": 6, "energy": 2, "claims": ["loop-harnessing-level"],
      "vo": "It writes down what it learned from every task, so the next one starts smarter.",
      "cues": { "i1": "writes", "i2": "learned", "i3": "every", "carry": "next" }, "accents": ["learned", "smarter."],
      "data": { "kind": "lessons", "from": "TASK 41 · DONE", "fromTitle": "Lessons saved", "toTitle": "Task 42",
