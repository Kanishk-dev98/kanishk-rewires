      "data": { "kind": "weights", "theme": "cream" },
      "sfx": [{ "name": "click", "on": { "cue": "strike" }, "volume": 0.3 }] },
    { "id": "s03", "type": "xBeat", "pad": 4, "energy": 3,
      "vo": "It's called Harness squared.", "accents": ["Harness"],
